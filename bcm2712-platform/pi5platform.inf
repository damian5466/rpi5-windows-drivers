[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/23/2026,0.2.0.0
CatalogFile=pi5platform.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTarm64.10.0
[Models.NTarm64.10.0]
%Rng%=Install,ACPI\RPI1014
%Thermal%=Install,ACPI\RPI1015

[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
Pi5Platform.sys=1
[DestinationDirs]
DriverCopy=13
[Install.NT]
CopyFiles=DriverCopy
[DriverCopy]
Pi5Platform.sys

[Install.NT.Services]
AddService=Pi5Platform,2,Service
[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\Pi5Platform.sys

[Install.NT.Wdf]
KmdfService=Pi5Platform,WdfSection
[WdfSection]
KmdfLibraryVersion=1.33

[Strings]
Provider="RPi5 UEFI project"
