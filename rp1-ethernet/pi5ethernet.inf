HKR,Ndi\Interfaces,LowerRange,0,"ethernet"
HKR,,*IfType,0x10001,6
HKR,,*MediaType,0x10001,0
HKR,,*PhysicalMediaType,0x10001,14
HKR,,ProbeOnly,0x10001,0

[Install.NT.Services]
